# Bot token from the Discord developer portal (Bot > Token). Required.
# (The old variable name DISCORDJS_BOT_TOKEN is still accepted.)
DISCORD_TOKEN=
# Application id (General Information > Application ID). Required only by `npm run deploy-commands`.
DISCORD_CLIENT_ID=
# Optional: deploy slash commands to this guild only (instant, for development). Leave empty for global.
DISCORD_GUILD_ID=
# Optional, defaults below. An empty value means "use the default".
COMMAND_PREFIX=!
LOG_LEVEL=info
QUEUE_TIMEOUT_MINUTES=60
# Optional: minutes before a queue expires at which an @everyone "last chance" reminder is posted (0 disables).
QUEUE_REMINDER_MINUTES=10
# Optional: answer the retired text commands (!rs7) with a notice. Needs the privileged Message Content
# intent enabled in the developer portal, otherwise the login fails. Off by default.
LEGACY_TEXT_COMMANDS=false
# Set by Heroku; needed elsewhere for JSON logs and to refuse the dev-only settings below.
NODE_ENV=
# Optional, local development only: POST http://127.0.0.1:<port>/shutdown runs the graceful shutdown
# (Windows cannot send the bot a termination signal). Refused when NODE_ENV=production.
DEV_SHUTDOWN_PORT=
